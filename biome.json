{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.vscode-test",
      "!.notes",
      "!**/seti/setiMap.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } },
  "html": { "experimentalFullSupportEnabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noEnum": "off",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "shared 必须保持中立：不得依赖 VSCode API（CLAUDE.md §A）。",
                  "vue": "shared 必须保持中立：不得依赖 UI 框架（CLAUDE.md §A）。"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/webview/src/logic/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vue": "webview/src/logic 是纯逻辑，要能在纯 node 下测，不得依赖 Vue（CLAUDE.md §A）。"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/extension/src/git/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "git/ 层必须能在纯 node 下裸测，不得 import vscode（CLAUDE.md §A）。"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/extension/src/core/**",
        "packages/extension/src/ipc/**",
        "packages/extension/src/vscode/**",
        "packages/extension/src/extension.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/git/commands/*", "!**/git/commands/index.js"],
                    "message": "git 命令只从 git/commands/index.js 引入：那里是全部 git 命令与最低版本的唯一清单。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/extension/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/git/*", "**/git/**"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
