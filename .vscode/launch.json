{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      // 第二个参数是调试窗口打开的目录：本仓库旁边的独立仓库 `<目录名>-debug`，
      // preLaunchTask 每次按当前场景从零重建（scripts/debug/setup.mjs）。
      // 换场景：pnpm debug:setup <场景名>，再按 F5。
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        "${workspaceFolder}/../${workspaceFolderBasename}-debug"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
