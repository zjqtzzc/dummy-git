{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      // 第二个参数是调试窗口打开的目录：本仓库旁边的 linked worktree
      // `<目录名>-debug`，preLaunchTask 每次自动建好或重置到当前 HEAD。
      // 不直接开本项目：当前窗口已经开着它，第二个窗口会被当成重复打开。
      // worktree 的历史就是本项目的历史，merge、改名、中文文件名都有，
      // 还顺带每次都走一遍 worktree 的路径。想换别的仓库改这一行即可。
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        "${workspaceFolder}/../${workspaceFolderBasename}-debug"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
