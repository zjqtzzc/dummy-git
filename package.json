{
  "name": "dummy-git-monorepo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "biome check . && node scripts/check-assertions.mjs",
    "lint:fix": "biome check --write .",
    "test": "node scripts/test.mjs",
    "debug:setup": "node scripts/debug-setup.mjs",
    "build": "pnpm -r run build",
    "watch": "pnpm -r --parallel run watch",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/node": "^22.10.0",
    "@vue/compiler-sfc": "3.5.43",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
