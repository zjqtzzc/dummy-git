{
  "name": "dummy-git",
  "displayName": "Dummy Git",
  "description": "不用记命令的 Git：JetBrains 式图形化操作，点两下就完事。",
  "version": "0.1.0",
  "publisher": "zjqtzzc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zjqtzzc/make-git-great-again.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:dummygit"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dummyGitSidebar",
          "title": "Dummy Git",
          "icon": "resources/log.svg"
        }
      ],
      "panel": [
        {
          "id": "dummyGit",
          "title": "Dummy Git",
          "icon": "resources/log.svg"
        }
      ]
    },
    "views": {
      "dummyGitSidebar": [
        {
          "type": "webview",
          "id": "dummyGit.commit",
          "name": "Commit"
        }
      ],
      "dummyGit": [
        {
          "type": "webview",
          "id": "dummyGit.log",
          "name": "Log"
        }
      ]
    },
    "commands": [
      {
        "command": "dummyGit.checkout",
        "title": "Checkout"
      },
      {
        "command": "dummyGit.checkoutRemote",
        "title": "Checkout"
      },
      {
        "command": "dummyGit.newBranch",
        "title": "New Branch from Here…"
      },
      {
        "command": "dummyGit.renameBranch",
        "title": "Rename…"
      },
      {
        "command": "dummyGit.deleteBranches",
        "title": "Delete"
      },
      {
        "command": "dummyGit.popStash",
        "title": "Pop"
      },
      {
        "command": "dummyGit.applyStash",
        "title": "Apply"
      },
      {
        "command": "dummyGit.dropStash",
        "title": "Delete"
      },
      {
        "command": "dummyGit.updateBranch",
        "title": "Update"
      },
      {
        "command": "dummyGit.pushBranch",
        "title": "Push…"
      },
      {
        "command": "dummyGit.mergeBranch",
        "title": "Merge into Current"
      },
      {
        "command": "dummyGit.rebaseBranch",
        "title": "Rebase onto This"
      },
      {
        "command": "dummyGit.copyHash",
        "title": "Copy Hash"
      },
      {
        "command": "dummyGit.cherryPick",
        "title": "Cherry-Pick"
      },
      {
        "command": "dummyGit.revertCommit",
        "title": "Revert"
      },
      {
        "command": "dummyGit.rebaseHere",
        "title": "Rebase onto Here"
      },
      {
        "command": "dummyGit.openMergeEditor",
        "title": "Open in Merge Editor"
      },
      {
        "command": "dummyGit.markResolved",
        "title": "Mark as Resolved"
      },
      {
        "command": "dummyGit.keepFile",
        "title": "Keep"
      },
      {
        "command": "dummyGit.removeConflictFile",
        "title": "Delete File"
      },
      {
        "command": "dummyGit.rollbackFile",
        "title": "Rollback"
      },
      {
        "command": "dummyGit.addUntracked",
        "title": "Add to Git"
      },
      {
        "command": "dummyGit.deleteUntracked",
        "title": "Delete"
      },
      {
        "command": "dummyGit.resetTo",
        "title": "Reset Current Branch to Here…"
      },
      {
        "command": "dummyGit.rewordCommit",
        "title": "Edit Commit Message…"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "dummyGit.checkout",
          "when": "webviewId == 'dummyGit.log' && dummyGit.checkout",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.checkoutRemote",
          "when": "webviewId == 'dummyGit.log' && dummyGit.checkoutRemote",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.newBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.newBranch",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.renameBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.renameBranch",
          "group": "3_edit@2"
        },
        {
          "command": "dummyGit.deleteBranches",
          "when": "webviewId == 'dummyGit.log' && dummyGit.deleteBranches",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.popStash",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.popStash",
          "group": "1_apply@1"
        },
        {
          "command": "dummyGit.applyStash",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.applyStash",
          "group": "1_apply@2"
        },
        {
          "command": "dummyGit.dropStash",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.dropStash",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.updateBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.updateBranch",
          "group": "2_sync@1"
        },
        {
          "command": "dummyGit.pushBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.pushBranch",
          "group": "2_sync@2"
        },
        {
          "command": "dummyGit.mergeBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.mergeBranch",
          "group": "2_sync@3"
        },
        {
          "command": "dummyGit.rebaseBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.rebaseBranch",
          "group": "2_sync@4"
        },
        {
          "command": "dummyGit.copyHash",
          "when": "webviewId == 'dummyGit.log' && dummyGit.copyHash",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.cherryPick",
          "when": "webviewId == 'dummyGit.log' && dummyGit.cherryPick",
          "group": "2_pick@1"
        },
        {
          "command": "dummyGit.revertCommit",
          "when": "webviewId == 'dummyGit.log' && dummyGit.revertCommit",
          "group": "2_pick@2"
        },
        {
          "command": "dummyGit.rebaseHere",
          "when": "webviewId == 'dummyGit.log' && dummyGit.rebaseHere",
          "group": "2_pick@3"
        },
        {
          "command": "dummyGit.openMergeEditor",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.openMergeEditor",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.markResolved",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.markResolved",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.keepFile",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.keepFile",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.removeConflictFile",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.removeConflictFile",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.rollbackFile",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.rollbackFile",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.addUntracked",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.addUntracked",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.deleteUntracked",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.deleteUntracked",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.resetTo",
          "when": "webviewId == 'dummyGit.log' && dummyGit.resetTo",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.rewordCommit",
          "when": "webviewId == 'dummyGit.log' && dummyGit.rewordCommit",
          "group": "3_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dummyGit.checkout",
          "when": "false"
        },
        {
          "command": "dummyGit.checkoutRemote",
          "when": "false"
        },
        {
          "command": "dummyGit.newBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.renameBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.deleteBranches",
          "when": "false"
        },
        {
          "command": "dummyGit.popStash",
          "when": "false"
        },
        {
          "command": "dummyGit.applyStash",
          "when": "false"
        },
        {
          "command": "dummyGit.dropStash",
          "when": "false"
        },
        {
          "command": "dummyGit.updateBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.pushBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.mergeBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.rebaseBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.copyHash",
          "when": "false"
        },
        {
          "command": "dummyGit.cherryPick",
          "when": "false"
        },
        {
          "command": "dummyGit.revertCommit",
          "when": "false"
        },
        {
          "command": "dummyGit.rebaseHere",
          "when": "false"
        },
        {
          "command": "dummyGit.openMergeEditor",
          "when": "false"
        },
        {
          "command": "dummyGit.markResolved",
          "when": "false"
        },
        {
          "command": "dummyGit.keepFile",
          "when": "false"
        },
        {
          "command": "dummyGit.removeConflictFile",
          "when": "false"
        },
        {
          "command": "dummyGit.rollbackFile",
          "when": "false"
        },
        {
          "command": "dummyGit.addUntracked",
          "when": "false"
        },
        {
          "command": "dummyGit.deleteUntracked",
          "when": "false"
        },
        {
          "command": "dummyGit.resetTo",
          "when": "false"
        },
        {
          "command": "dummyGit.rewordCommit",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm -w run build",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@dummy-git/shared": "workspace:*",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.2"
  }
}
