{
  "name": "dummy-git",
  "displayName": "Dummy Git",
  "description": "不用记命令的 Git：JetBrains 式图形化操作，点两下就完事。",
  "version": "0.0.0",
  "publisher": "zjqtzzc",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:dummygit"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dummyGitSidebar",
          "title": "Dummy Git",
          "icon": "resources/log.svg"
        }
      ],
      "panel": [
        {
          "id": "dummyGit",
          "title": "Dummy Git",
          "icon": "resources/log.svg"
        }
      ]
    },
    "views": {
      "dummyGitSidebar": [
        {
          "type": "webview",
          "id": "dummyGit.commit",
          "name": "Commit"
        }
      ],
      "dummyGit": [
        {
          "type": "webview",
          "id": "dummyGit.log",
          "name": "Log"
        }
      ]
    },
    "commands": [
      {
        "command": "dummyGit.checkout",
        "title": "Checkout"
      },
      {
        "command": "dummyGit.checkoutRemote",
        "title": "Checkout"
      },
      {
        "command": "dummyGit.newBranch",
        "title": "New Branch from Here…"
      },
      {
        "command": "dummyGit.renameBranch",
        "title": "Rename…"
      },
      {
        "command": "dummyGit.deleteBranch",
        "title": "Delete"
      },
      {
        "command": "dummyGit.deleteRemoteBranch",
        "title": "Delete"
      },
      {
        "command": "dummyGit.popStash",
        "title": "Pop"
      },
      {
        "command": "dummyGit.applyStash",
        "title": "Apply"
      },
      {
        "command": "dummyGit.dropStash",
        "title": "Delete"
      },
      {
        "command": "dummyGit.pullBranch",
        "title": "Pull"
      },
      {
        "command": "dummyGit.pushBranch",
        "title": "Push"
      },
      {
        "command": "dummyGit.copyHash",
        "title": "Copy Hash"
      },
      {
        "command": "dummyGit.openMergeEditor",
        "title": "Open in Merge Editor"
      },
      {
        "command": "dummyGit.markResolved",
        "title": "Mark as Resolved"
      },
      {
        "command": "dummyGit.keepFile",
        "title": "Keep"
      },
      {
        "command": "dummyGit.removeConflictFile",
        "title": "Delete File"
      },
      {
        "command": "dummyGit.rollbackFile",
        "title": "Rollback"
      },
      {
        "command": "dummyGit.deleteUntracked",
        "title": "Delete"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "dummyGit.checkout",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'localBranch' && !dummyGit.current",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.checkoutRemote",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'remoteBranch'",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.newBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.start",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.renameBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'localBranch'",
          "group": "3_edit@2"
        },
        {
          "command": "dummyGit.deleteBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'localBranch' && !dummyGit.current",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.deleteRemoteBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'remoteBranch'",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.popStash",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'stash'",
          "group": "1_apply@1"
        },
        {
          "command": "dummyGit.applyStash",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'stash'",
          "group": "1_apply@2"
        },
        {
          "command": "dummyGit.dropStash",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'stash'",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.pullBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'localBranch'",
          "group": "2_sync@1"
        },
        {
          "command": "dummyGit.pushBranch",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'localBranch'",
          "group": "2_sync@2"
        },
        {
          "command": "dummyGit.copyHash",
          "when": "webviewId == 'dummyGit.log' && dummyGit.node == 'commit'",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.openMergeEditor",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'conflictMerge'",
          "group": "1_switch@1"
        },
        {
          "command": "dummyGit.markResolved",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'conflictMerge'",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.keepFile",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'conflictDeleted'",
          "group": "3_edit@1"
        },
        {
          "command": "dummyGit.removeConflictFile",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'conflictDeleted'",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.removeConflictFile",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'conflictBothDeleted'",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.rollbackFile",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'change'",
          "group": "4_delete@1"
        },
        {
          "command": "dummyGit.deleteUntracked",
          "when": "webviewId == 'dummyGit.commit' && dummyGit.node == 'untracked'",
          "group": "4_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dummyGit.checkout",
          "when": "false"
        },
        {
          "command": "dummyGit.checkoutRemote",
          "when": "false"
        },
        {
          "command": "dummyGit.newBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.renameBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.deleteBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.deleteRemoteBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.popStash",
          "when": "false"
        },
        {
          "command": "dummyGit.applyStash",
          "when": "false"
        },
        {
          "command": "dummyGit.dropStash",
          "when": "false"
        },
        {
          "command": "dummyGit.pullBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.pushBranch",
          "when": "false"
        },
        {
          "command": "dummyGit.copyHash",
          "when": "false"
        },
        {
          "command": "dummyGit.openMergeEditor",
          "when": "false"
        },
        {
          "command": "dummyGit.markResolved",
          "when": "false"
        },
        {
          "command": "dummyGit.keepFile",
          "when": "false"
        },
        {
          "command": "dummyGit.removeConflictFile",
          "when": "false"
        },
        {
          "command": "dummyGit.rollbackFile",
          "when": "false"
        },
        {
          "command": "dummyGit.deleteUntracked",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm -w run build",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@dummy-git/shared": "workspace:*",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.2"
  }
}
